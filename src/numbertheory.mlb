(* MLB for the sml-numbertheory library: the vendored sml-bigint core plus the
 * number-theory sources.  Consumers reference this file.
 *
 * The dependency .mlb is brought in WITHOUT a `local` wrapper so that
 * consumers (the test suite, examples) can `open BigInt` alongside
 * NumberTheory. *)
$(SML_LIB)/basis/basis.mlb
../lib/github.com/sjqtentacles/sml-bigint/bigint.mlb
numbertheory.sig
numbertheory.sml
